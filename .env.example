# ==============================================================================
# WhyLine Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase (Database, pgvector, and REST sync)
# ------------------------------------------------------------------------------
# Your Supabase Project URL (from Supabase Dashboard > Project Settings > API)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Service Role Key (from Supabase Dashboard > Project Settings > API)
# Required for server-side upserts into `voice_pins` and `ast_nodes`
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# (Optional) Supabase Anon Key (for public client read operations)
# SUPABASE_ANON_KEY=your-supabase-anon-key

# ------------------------------------------------------------------------------
# 2. Gnani Vachana AI Platform (STT & TTS)
# ------------------------------------------------------------------------------
# API Key from https://api.vachana.ai (or console.vachana.ai)
# Powers Prisma v2.5 (Code-mixed STT) and Timbre v2.5 (16kHz WAV TTS)
# If omitted, WhyLine automatically runs in local deterministic sandbox fallback mode
GNANI_API_KEY=your-gnani-vachana-api-key

# ------------------------------------------------------------------------------
# 3. GitHub API (Provenance Mining & PR Archaeology)
# ------------------------------------------------------------------------------
# GitHub Personal Access Token (classic or fine-grained with repo read scope)
# Used to fetch PR descriptions, inline code reviews, and linked Issue/Jira keys
# If omitted, WhyLine automatically falls back to local `git blame` and `git log`
GITHUB_TOKEN=your-github-personal-access-token

# ------------------------------------------------------------------------------
# 4. Webhook Authentication Secret (HMAC-SHA256)
# ------------------------------------------------------------------------------
WEBHOOK_SECRET=your-random-webhook-secret-here

# Optional repository slug override for PR enrichment (e.g. owner/repo)
# GITHUB_REPO_SLUG=your-org/HealthConnect
